{
  "name": "nspark-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Newtonian Spark prompts to agents",
  "type": "module",
  "bin": {
    "nspark-mcp": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "model-context-protocol", "prompt", "llm", "ai", "nspark"],
