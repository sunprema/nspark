<Layouts.flash_group flash={@flash} />

<style>
  @keyframes grid-drift {
    0% { background-position: 0 0; }
    100% { background-position: 120px 120px; }
  }

  @keyframes node-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.65; }
  }

  @keyframes edge-flow {
    0% { stroke-dashoffset: 24; }
    100% { stroke-dashoffset: 0; }
  }

  @keyframes scan-line {
    0% { transform: translateY(-100%); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(100vh); opacity: 0; }
  }

  @keyframes float-up {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-6px); }
    100% { transform: translateY(0px); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease forwards;
  }

  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  .delay-300 { animation-delay: 0.3s; }
  .delay-400 { animation-delay: 0.4s; }

  .node-pulse { animation: node-pulse 3s ease-in-out infinite; }
  .node-pulse-2 { animation: node-pulse 3s ease-in-out infinite 0.5s; }
  .node-pulse-3 { animation: node-pulse 3s ease-in-out infinite 1s; }
  .node-pulse-4 { animation: node-pulse 3s ease-in-out infinite 1.5s; }
  .node-pulse-5 { animation: node-pulse 3s ease-in-out infinite 2s; }

  .edge-flow {
    stroke-dasharray: 6 6;
    animation: edge-flow 1.2s linear infinite;
  }

  .edge-flow-slow {
    stroke-dasharray: 6 6;
    animation: edge-flow 2s linear infinite;
  }

  .float-1 { animation: float-up 4s ease-in-out infinite; }
  .float-2 { animation: float-up 4s ease-in-out infinite 1.3s; }
  .float-3 { animation: float-up 4s ease-in-out infinite 2.6s; }

  .cursor-blink { animation: blink 1.1s step-end infinite; }

  .hero-grid {
    background-color: oklch(0.94 0.006 250);
    background-image:
      linear-gradient(oklch(0.875 0.01 250 / 0.7) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.875 0.01 250 / 0.7) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, oklch(0.55 0.13 255 / 0.4), transparent);
    animation: scan-line 8s linear infinite;
    pointer-events: none;
  }

  .section-grid {
    background-color: oklch(0.97 0.004 245);
    background-image:
      linear-gradient(oklch(0.88 0.008 250 / 0.5) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.88 0.008 250 / 0.5) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .node-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .node-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px -8px oklch(0.3 0.05 255 / 0.2);
  }

  .feature-card {
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .feature-card:hover {
    background-color: oklch(0.975 0.006 250);
    border-color: oklch(0.55 0.13 255 / 0.4);
  }

  .cta-btn {
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -4px oklch(0.55 0.13 255 / 0.45);
  }
  .cta-btn-outline:hover {
    box-shadow: none;
    background-color: oklch(0.96 0.01 250);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border: 1px solid;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 500;
  }
</style>

<div style="font-family: 'IBM Plex Sans', system-ui, sans-serif; color: oklch(0.22 0.02 255); min-height: 100vh;">

  <!-- ========== NAV ========== -->
  <nav style="position: sticky; top: 0; z-index: 50; backdrop-filter: blur(12px); background: oklch(0.97 0.004 245 / 0.9); border-bottom: 1px solid oklch(0.85 0.01 250);">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 32px; height: 56px; display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 26px; height: 26px; border: 2px solid oklch(0.3 0.02 255); display: flex; align-items: center; justify-content: center;">
          <div style="width: 10px; height: 10px; background: oklch(0.55 0.13 255); transform: rotate(45deg);"></div>
        </div>
        <span style="font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 15px; letter-spacing: -0.01em;">
          Newtonian<span style="color: oklch(0.55 0.13 255);">Spark</span>
        </span>
      </div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="/sign-in" style="font-size: 13px; font-weight: 500; color: oklch(0.4 0.02 255); padding: 8px 16px; border: 1px solid oklch(0.82 0.02 250); text-decoration: none; transition: background 0.15s ease;" class="cta-btn-outline cta-btn">
          Sign in
        </a>
        <a href="/studio" style="font-size: 13px; font-weight: 600; color: oklch(0.99 0.003 245); background: oklch(0.3 0.02 255); padding: 8px 18px; text-decoration: none;" class="cta-btn">
          Open Studio &rarr;
        </a>
      </div>
    </div>
  </nav>

  <!-- ========== HERO ========== -->
  <section class="hero-grid" style="position: relative; overflow: hidden; padding: 80px 32px 96px;">
    <div class="scan-line"></div>

    <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;">

      <!-- Left: copy -->
      <div class="animate-fade-in-up" style="opacity: 0;">
        <div class="pill" style="color: oklch(0.55 0.13 255); border-color: oklch(0.72 0.1 255 / 0.5); background: oklch(0.96 0.03 255 / 0.6); margin-bottom: 24px;">
          <span style="width: 6px; height: 6px; background: oklch(0.55 0.13 255); border-radius: 50%;"></span>
          AGENT ARCHITECTURE PLATFORM
        </div>

        <h1 style="font-size: clamp(2.2rem, 4vw, 3.5rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 24px;">
          Build AI Agents<br/>
          <span style="color: oklch(0.55 0.13 255);">Like Software.</span>
        </h1>

        <p style="font-size: 18px; line-height: 1.65; color: oklch(0.38 0.02 255); margin: 0 0 36px; max-width: 480px;">
          Newtonian Spark is a visual architecture platform that transforms prompts, skills, and memory into structured, versioned, deployable agent systems.
        </p>

        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: oklch(0.45 0.02 250); border-left: 3px solid oklch(0.55 0.13 255); padding-left: 16px; margin-bottom: 40px; line-height: 1.8;">
          Prompts &rarr; <strong style="color: oklch(0.3 0.02 255);">Modular Logic</strong><br/>
          Skills &rarr; <strong style="color: oklch(0.3 0.02 255);">Reusable Assets</strong><br/>
          Knowledge &rarr; <strong style="color: oklch(0.3 0.02 255);">Composable Architecture</strong>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/studio" style="font-size: 14px; font-weight: 600; color: oklch(0.99 0.003 245); background: oklch(0.3 0.02 255); padding: 12px 24px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;" class="cta-btn">
            Start Building
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#how-it-works" style="font-size: 14px; font-weight: 500; color: oklch(0.38 0.02 255); background: oklch(0.985 0.004 245); border: 1px solid oklch(0.78 0.02 250); padding: 12px 24px; text-decoration: none;" class="cta-btn cta-btn-outline">
            See How It Works
          </a>
        </div>

        <div style="display: flex; gap: 32px; margin-top: 48px; padding-top: 32px; border-top: 1px solid oklch(0.85 0.01 250);">
          <div>
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 22px; font-weight: 600; color: oklch(0.3 0.02 255);">9</div>
            <div style="font-size: 12px; color: oklch(0.52 0.02 250); margin-top: 2px;">Node Types</div>
          </div>
          <div>
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 22px; font-weight: 600; color: oklch(0.3 0.02 255);">7</div>
            <div style="font-size: 12px; color: oklch(0.52 0.02 250); margin-top: 2px;">Compile Phases</div>
          </div>
          <div>
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 22px; font-weight: 600; color: oklch(0.3 0.02 255);">3</div>
            <div style="font-size: 12px; color: oklch(0.52 0.02 250); margin-top: 2px;">Environments</div>
          </div>
          <div>
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 22px; font-weight: 600; color: oklch(0.3 0.02 255);">∞</div>
            <div style="font-size: 12px; color: oklch(0.52 0.02 250); margin-top: 2px;">Reusable Skills</div>
          </div>
        </div>
      </div>

      <!-- Right: animated graph -->
      <div class="float-1 animate-fade-in-up delay-200" style="opacity: 0;">
        <svg viewBox="0 0 480 380" style="width: 100%; max-width: 520px; margin-left: auto; display: block;" xmlns="http://www.w3.org/2000/svg">
          <!-- Grid dots -->
          <defs>
            <pattern id="dotgrid" x="0" y="0" width="30" height="30" patternUnits="userSpaceOnUse">
              <circle cx="15" cy="15" r="1" fill="oklch(0.78 0.015 250)" />
            </pattern>
            <filter id="glow-blue">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <rect width="480" height="380" fill="url(#dotgrid)" rx="4"/>

          <!-- Edges / connections -->
          <!-- Persona -> Constraint -->
          <line x1="200" y1="72" x2="340" y2="72" stroke="oklch(0.55 0.13 255)" stroke-width="1.5" class="edge-flow" />
          <!-- Persona -> Context -->
          <line x1="115" y1="90" x2="115" y2="148" stroke="oklch(0.55 0.13 255)" stroke-width="1.5" class="edge-flow" />
          <!-- Constraint -> Skill -->
          <line x1="355" y1="90" x2="290" y2="190" stroke="oklch(0.55 0.14 28)" stroke-width="1.5" class="edge-flow-slow" />
          <!-- Context -> Skill -->
          <line x1="140" y1="170" x2="230" y2="204" stroke="oklch(0.55 0.12 155)" stroke-width="1.5" class="edge-flow" />
          <!-- Skill -> Output -->
          <line x1="260" y1="232" x2="230" y2="306" stroke="oklch(0.62 0.13 78)" stroke-width="1.5" class="edge-flow-slow" />
          <!-- Context -> Memory -->
          <line x1="100" y1="188" x2="78" y2="254" stroke="oklch(0.55 0.12 155)" stroke-width="1.5" class="edge-flow" />
          <!-- Memory -> Output -->
          <line x1="98" y1="280" x2="186" y2="320" stroke="oklch(0.52 0.13 300)" stroke-width="1.5" class="edge-flow-slow" />

          <!-- PERSONA node -->
          <g class="node-pulse">
            <rect x="60" y="48" width="140" height="44" rx="2" fill="oklch(0.985 0.004 245)" stroke="oklch(0.78 0.02 250)" stroke-width="1"/>
            <rect x="60" y="48" width="4" height="44" rx="2" fill="oklch(0.55 0.13 255)"/>
            <text x="76" y="65" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.55 0.13 255)" font-weight="600" letter-spacing="0.12em">PERSONA</text>
            <text x="76" y="80" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="oklch(0.38 0.02 255)">Research Agent</text>
          </g>

          <!-- CONSTRAINT node -->
          <g class="node-pulse-2">
            <rect x="300" y="48" width="144" height="44" rx="2" fill="oklch(0.985 0.004 245)" stroke="oklch(0.78 0.02 250)" stroke-width="1"/>
            <rect x="300" y="48" width="4" height="44" rx="2" fill="oklch(0.55 0.14 28)"/>
            <text x="316" y="65" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.55 0.14 28)" font-weight="600" letter-spacing="0.12em">CONSTRAINT</text>
            <text x="316" y="80" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="oklch(0.38 0.02 255)">Citation required</text>
          </g>

          <!-- CONTEXT node -->
          <g class="node-pulse-3">
            <rect x="52" y="148" width="148" height="44" rx="2" fill="oklch(0.985 0.004 245)" stroke="oklch(0.78 0.02 250)" stroke-width="1"/>
            <rect x="52" y="148" width="4" height="44" rx="2" fill="oklch(0.55 0.12 155)"/>
            <text x="68" y="165" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.55 0.12 155)" font-weight="600" letter-spacing="0.12em">CONTEXT</text>
            <text x="68" y="180" font-family="IBM Plex Mono, monospace" font-size="9" fill="oklch(0.48 0.02 255)">&#123;customer_profile&#125;</text>
          </g>

          <!-- SKILL node -->
          <g class="node-pulse-4">
            <rect x="208" y="188" width="138" height="44" rx="2" fill="oklch(0.985 0.004 245)" stroke="oklch(0.55 0.13 255 / 0.3)" stroke-width="1"/>
            <rect x="208" y="188" width="4" height="44" rx="2" fill="oklch(0.62 0.13 78)"/>
            <text x="224" y="205" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.62 0.13 78)" font-weight="600" letter-spacing="0.12em">SKILL</text>
            <text x="224" y="220" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="oklch(0.38 0.02 255)">Planning · v2</text>
            <circle cx="336" cy="210" r="3" fill="oklch(0.62 0.13 78 / 0.2)" stroke="oklch(0.62 0.13 78)" stroke-width="1"/>
          </g>

          <!-- MEMORY node -->
          <g class="node-pulse-2">
            <rect x="36" y="254" width="128" height="44" rx="2" fill="oklch(0.985 0.004 245)" stroke="oklch(0.78 0.02 250)" stroke-width="1"/>
            <rect x="36" y="254" width="4" height="44" rx="2" fill="oklch(0.52 0.13 300)"/>
            <text x="52" y="271" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.52 0.13 300)" font-weight="600" letter-spacing="0.12em">MEMORY</text>
            <text x="52" y="286" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="oklch(0.38 0.02 255)">Episodic · linked</text>
          </g>

          <!-- OUTPUT node (selected state with glow) -->
          <g class="node-pulse-5" filter="url(#glow-blue)">
            <rect x="174" y="300" width="148" height="52" rx="2" fill="oklch(0.985 0.004 245)" stroke="oklch(0.52 0.13 300)" stroke-width="1.5"/>
            <rect x="174" y="300" width="4" height="52" rx="2" fill="oklch(0.52 0.13 300)"/>
            <text x="190" y="318" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.52 0.13 300)" font-weight="600" letter-spacing="0.12em">OUTPUT</text>
            <text x="190" y="332" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="oklch(0.38 0.02 255)">JSON Schema · strict</text>
            <text x="190" y="344" font-family="IBM Plex Mono, monospace" font-size="8" fill="oklch(0.55 0.12 155)">✓ compiled</text>
          </g>

          <!-- Compiler panel preview (right side) -->
          <g transform="translate(356, 148)">
            <rect width="116" height="160" rx="2" fill="oklch(0.22 0.025 255)" stroke="oklch(0.35 0.025 255)" stroke-width="1"/>
            <text x="10" y="18" font-family="IBM Plex Mono, monospace" font-size="7" fill="oklch(0.55 0.02 250)" letter-spacing="0.1em">COMPILER</text>
            <line x1="0" y1="26" x2="116" y2="26" stroke="oklch(0.35 0.025 255)" stroke-width="0.5"/>
            <text x="10" y="40" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.55 0.13 255)">01 PERSONA</text>
            <text x="10" y="54" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.55 0.14 28)">02 CONSTRAINTS</text>
            <text x="10" y="68" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.55 0.12 155)">03 CONTEXT</text>
            <text x="10" y="82" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.62 0.13 78)">04 SKILLS</text>
            <text x="10" y="96" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.52 0.13 300)">05 MEMORY</text>
            <text x="10" y="110" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.55 0.12 155)">06 EVALUATIONS</text>
            <text x="10" y="124" font-family="IBM Plex Mono, monospace" font-size="6.5" fill="oklch(0.52 0.13 300)">07 OUTPUT</text>
            <line x1="0" y1="132" x2="116" y2="132" stroke="oklch(0.35 0.025 255)" stroke-width="0.5"/>
            <text x="10" y="145" font-family="IBM Plex Mono, monospace" font-size="6" fill="oklch(0.55 0.02 250)">2,431 tokens</text>
            <text x="10" y="157" font-family="IBM Plex Mono, monospace" font-size="6" fill="oklch(0.55 0.12 155)">✓ ready</text>
          </g>

          <!-- Decorative corner markers -->
          <line x1="0" y1="0" x2="16" y2="0" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="0" y1="0" x2="0" y2="16" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="480" y1="0" x2="464" y2="0" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="480" y1="0" x2="480" y2="16" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="0" y1="380" x2="16" y2="380" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="0" y1="380" x2="0" y2="364" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="480" y1="380" x2="464" y2="380" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>
          <line x1="480" y1="380" x2="480" y2="364" stroke="oklch(0.55 0.02 250)" stroke-width="1"/>

          <!-- Label -->
          <text x="8" y="370" font-family="IBM Plex Mono, monospace" font-size="7" fill="oklch(0.6 0.015 250)" letter-spacing="0.1em">GRAPH · agent_planner_001 · v18</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ========== POSITIONING STRIP ========== -->
  <div style="background: oklch(0.22 0.025 255); padding: 20px 32px; overflow: hidden;">
    <div style="max-width: 1280px; margin: 0 auto; display: flex; align-items: center; gap: 48px; flex-wrap: wrap; justify-content: center;">
      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; color: oklch(0.55 0.02 250);">NOT&nbsp;A&nbsp;CHAT&nbsp;APP.</div>
      <div style="width: 1px; height: 20px; background: oklch(0.35 0.025 255);"></div>
      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; color: oklch(0.55 0.02 250);">NOT&nbsp;A&nbsp;WORKFLOW&nbsp;BUILDER.</div>
      <div style="width: 1px; height: 20px; background: oklch(0.35 0.025 255);"></div>
      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; color: oklch(0.65 0.13 255);">AN&nbsp;IDE&nbsp;FOR&nbsp;AI&nbsp;BEHAVIOR.</div>
    </div>
  </div>

  <!-- ========== HOW IT WORKS ========== -->
  <section id="how-it-works" style="padding: 96px 32px; background: oklch(0.985 0.004 245);">
    <div style="max-width: 1280px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 64px;">
        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: oklch(0.55 0.02 250); margin-bottom: 12px;">HOW IT WORKS</div>
        <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 16px;">From chaos to architecture in three steps.</h2>
        <p style="font-size: 16px; color: oklch(0.44 0.02 255); max-width: 560px; margin: 0 auto; line-height: 1.6;">Stop maintaining prompt documents. Build agent systems with the same rigor you apply to software.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: oklch(0.85 0.01 250);">
        <!-- Step 1 -->
        <div style="background: oklch(0.985 0.004 245); padding: 48px 36px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 32px; font-weight: 600; color: oklch(0.88 0.01 250); margin-bottom: 20px; line-height: 1;">01</div>
          <div style="width: 40px; height: 40px; border: 1.5px solid oklch(0.55 0.13 255); display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="3" y="3" width="14" height="3" rx="1" fill="oklch(0.55 0.13 255)" opacity="0.3"/>
              <rect x="3" y="3" width="4" height="14" rx="1" fill="oklch(0.55 0.13 255)"/>
              <rect x="9" y="8" width="8" height="2" rx="1" fill="oklch(0.55 0.13 255)" opacity="0.6"/>
              <rect x="9" y="12" width="5" height="2" rx="1" fill="oklch(0.55 0.13 255)" opacity="0.4"/>
            </svg>
          </div>
          <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 12px;">Design the Graph</h3>
          <p style="font-size: 14px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">Drag nodes onto the canvas. Connect Persona, Constraints, Context, Skills, Memory, and Output nodes into a directed architecture graph.</p>
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: oklch(0.55 0.13 255); letter-spacing: 0.08em;">9 node types &rarr; infinite patterns</div>
        </div>

        <!-- Step 2 -->
        <div style="background: oklch(0.985 0.004 245); padding: 48px 36px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 32px; font-weight: 600; color: oklch(0.88 0.01 250); margin-bottom: 20px; line-height: 1;">02</div>
          <div style="width: 40px; height: 40px; border: 1.5px solid oklch(0.55 0.14 28); display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 3v14M3 10l7-7 7 7" stroke="oklch(0.55 0.14 28)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 12px;">Compile &amp; Validate</h3>
          <p style="font-size: 14px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">The live compiler assembles your graph in real-time. Catch circular dependencies, undefined variables, and schema conflicts before they reach production.</p>
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: oklch(0.55 0.14 28); letter-spacing: 0.08em;">7 phases &rarr; validated artifact</div>
        </div>

        <!-- Step 3 -->
        <div style="background: oklch(0.985 0.004 245); padding: 48px 36px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 32px; font-weight: 600; color: oklch(0.88 0.01 250); margin-bottom: 20px; line-height: 1;">03</div>
          <div style="width: 40px; height: 40px; border: 1.5px solid oklch(0.55 0.12 155); display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="7" stroke="oklch(0.55 0.12 155)" stroke-width="1.5"/>
              <path d="M7 10l2.5 2.5L14 7" stroke="oklch(0.55 0.12 155)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 12px;">Deploy to Production</h3>
          <p style="font-size: 14px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">Publish a versioned snapshot. Deploy to Dev, Staging, or Production environments. Your applications call a runtime API endpoint — no embedded prompts.</p>
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: oklch(0.55 0.12 155); letter-spacing: 0.08em;">3 environments &rarr; one runtime API</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURES ========== -->
  <section class="section-grid" style="padding: 96px 32px;">
    <div style="max-width: 1280px; margin: 0 auto;">
      <div style="margin-bottom: 56px;">
        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: oklch(0.55 0.02 250); margin-bottom: 12px;">PLATFORM CAPABILITIES</div>
        <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin: 0;">Engineering-grade tools for agent architecture.</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: oklch(0.85 0.01 250);">

        <!-- Visual Graph -->
        <div class="feature-card" style="background: oklch(0.985 0.004 245); padding: 36px; border: 1px solid transparent;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <div style="width: 8px; height: 32px; background: oklch(0.55 0.13 255);"></div>
            <div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.15em; color: oklch(0.55 0.13 255); margin-bottom: 3px;">CORE</div>
              <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Visual Graph Workspace</h3>
            </div>
          </div>
          <p style="font-size: 13.5px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">A Directed Acyclic Graph canvas where every instruction is a node, every dependency is a visible connection, and every output is traceable. Infinite pan, zoom, multi-select.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Svelte Flow</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Minimap</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Variable Explorer</span>
          </div>
        </div>

        <!-- Live Compiler -->
        <div class="feature-card" style="background: oklch(0.985 0.004 245); padding: 36px; border: 1px solid transparent;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <div style="width: 8px; height: 32px; background: oklch(0.55 0.14 28);"></div>
            <div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.15em; color: oklch(0.55 0.14 28); margin-bottom: 3px;">CORE</div>
              <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Live Compiler</h3>
            </div>
          </div>
          <p style="font-size: 13.5px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">Watch your compiled prompt assemble in real-time as you edit. Token counts, cost estimates, and compression metrics update instantly. Diagnostics surface errors before they escape.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">7-phase pipeline</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Token metrics</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Diagnostics</span>
          </div>
        </div>

        <!-- Skill Registry -->
        <div class="feature-card" style="background: oklch(0.985 0.004 245); padding: 36px; border: 1px solid transparent;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <div style="width: 8px; height: 32px; background: oklch(0.55 0.12 155);"></div>
            <div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.15em; color: oklch(0.55 0.12 155); margin-bottom: 3px;">REGISTRY</div>
              <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Knowledge Registry</h3>
            </div>
          </div>
          <p style="font-size: 13.5px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">A central repository for Skills, Policies, Output Schemas, and Memory Templates. Linked skills update everywhere they're used. Versioned. Diffable. Rollback-ready.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Linked / Cloned</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Versioned</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Cross-project</span>
          </div>
        </div>

        <!-- AI Architect -->
        <div class="feature-card" style="background: oklch(0.985 0.004 245); padding: 36px; border: 1px solid transparent;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <div style="width: 8px; height: 32px; background: oklch(0.62 0.13 78);"></div>
            <div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.15em; color: oklch(0.62 0.13 78); margin-bottom: 3px;">AI</div>
              <h3 style="font-size: 16px; font-weight: 700; margin: 0;">AI Architect Copilot</h3>
            </div>
          </div>
          <p style="font-size: 13.5px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">A natural-language copilot that modifies your graph directly — not just text. Import legacy prompts and watch them decompose into structured architecture automatically.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Prompt import</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Refactor mode</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Graph mutation</span>
          </div>
        </div>

        <!-- Version Control -->
        <div class="feature-card" style="background: oklch(0.985 0.004 245); padding: 36px; border: 1px solid transparent;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <div style="width: 8px; height: 32px; background: oklch(0.52 0.13 300);"></div>
            <div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.15em; color: oklch(0.52 0.13 300); margin-bottom: 3px;">VERSIONING</div>
              <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Graph Versioning</h3>
            </div>
          </div>
          <p style="font-size: 13.5px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">Every publish creates an immutable snapshot — graph, dependencies, and compiler output together. Visual diff viewer. One-click rollback. Full audit trail for compliance and governance.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Immutable snapshots</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Visual diff</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Rollback</span>
          </div>
        </div>

        <!-- Deployment -->
        <div class="feature-card" style="background: oklch(0.985 0.004 245); padding: 36px; border: 1px solid transparent;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <div style="width: 8px; height: 32px; background: oklch(0.42 0.05 255);"></div>
            <div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.15em; color: oklch(0.42 0.05 255); margin-bottom: 3px;">RUNTIME</div>
              <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Runtime Deployment</h3>
            </div>
          </div>
          <p style="font-size: 13.5px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 20px;">Deploy any graph as a JSON API endpoint. Applications inject runtime variables and receive compiled, model-ready instructions. Version pinning ensures deployments never drift unexpectedly.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Dev/Staging/Prod</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">REST API</span>
            <span class="pill" style="color: oklch(0.44 0.02 255); border-color: oklch(0.82 0.02 250);">Version pinning</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========== NODE SYSTEM ========== -->
  <section style="padding: 96px 32px; background: oklch(0.985 0.004 245); border-top: 1px solid oklch(0.88 0.008 250);">
    <div style="max-width: 1280px; margin: 0 auto;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start;">

        <div>
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: oklch(0.55 0.02 250); margin-bottom: 12px;">NODE SYSTEM</div>
          <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 20px;">Nine components.<br/>One coherent system.</h2>
          <p style="font-size: 15px; line-height: 1.7; color: oklch(0.44 0.02 255); margin: 0 0 36px;">Every part of an agent's behavior has a first-class representation. Node type determines compile order, validation rules, and how the compiler assembles the final artifact.</p>

          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; background: oklch(0.22 0.025 255); padding: 24px 28px; color: oklch(0.7 0.015 250); line-height: 2;">
            <span style="color: oklch(0.55 0.13 255);">PERSONA</span> &rarr;
            <span style="color: oklch(0.55 0.14 28);">CONSTRAINTS</span> &rarr;
            <span style="color: oklch(0.55 0.12 155);">CONTEXT</span> &rarr;<br/>
            <span style="color: oklch(0.62 0.13 78);">SKILLS</span> &rarr;
            <span style="color: oklch(0.52 0.13 300);">MEMORY</span> &rarr;
            <span style="color: oklch(0.55 0.12 155);">EVALUATIONS</span> &rarr;<br/>
            <span style="color: oklch(0.52 0.13 300);">OUTPUT</span>
            <span style="color: oklch(0.35 0.025 255);"> &larr; compile order</span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
          <%= for {type, color, desc} <- [
            {"PERSONA", "oklch(0.55 0.13 255)", "Identity, role, tone"},
            {"CONSTRAINT", "oklch(0.55 0.14 28)", "Rules & guardrails"},
            {"CONTEXT", "oklch(0.55 0.12 155)", "Variables & runtime data"},
            {"CONDITIONAL", "oklch(0.62 0.13 78)", "Branching logic"},
            {"SKILL", "oklch(0.62 0.13 78)", "Reusable capability"},
            {"MEMORY", "oklch(0.52 0.13 300)", "Long-term knowledge"},
            {"TOOL", "oklch(0.42 0.05 255)", "External integrations"},
            {"EVALUATION", "oklch(0.55 0.12 155)", "Self-check rules"},
            {"OUTPUT", "oklch(0.52 0.13 300)", "Schema & format"}
          ] do %>
            <div class="node-card" style={"background: oklch(0.985 0.004 245); border: 1px solid oklch(0.85 0.01 250); display: flex; overflow: hidden;"}>
              <div style={"width: 4px; background: #{color}; flex-shrink: 0;"}></div>
              <div style="padding: 12px 14px;">
                <div style={"font-family: 'IBM Plex Mono', monospace; font-size: 8.5px; font-weight: 600; letter-spacing: 0.12em; color: #{color}; margin-bottom: 3px;"}><%= type %></div>
                <div style="font-size: 11px; color: oklch(0.48 0.02 255);"><%= desc %></div>
              </div>
            </div>
          <% end %>
        </div>

      </div>
    </div>
  </section>

  <!-- ========== FOR TEAMS ========== -->
  <section class="section-grid" style="padding: 96px 32px; border-top: 1px solid oklch(0.88 0.008 250);">
    <div style="max-width: 1280px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: oklch(0.55 0.02 250); margin-bottom: 12px;">FOR TEAMS</div>
        <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin: 0;">Built for every stakeholder in AI delivery.</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: oklch(0.85 0.01 250);">
        <%= for {role, tagline, items, color} <- [
          {"AI Engineers", "Build production agents with complex reasoning workflows.",
           ["9 node types", "Live compiler", "Runtime API", "Variable analysis"],
           "oklch(0.55 0.13 255)"},
          {"Agent Architects", "Design behavior across multiple systems and teams.",
           ["Visual DAG canvas", "Skill Registry", "Package bundles", "Dependency tracking"],
           "oklch(0.55 0.14 28)"},
          {"Product Managers", "Audit and manage business logic without touching code.",
           ["Read-only access", "Version history", "Diff viewer", "Deployment status"],
           "oklch(0.55 0.12 155)"},
          {"Enterprise Teams", "Governance, compliance, and operational oversight.",
           ["Role-based access", "Audit trail", "Policy registry", "Multi-environment"],
           "oklch(0.52 0.13 300)"}
        ] do %>
          <div style="background: oklch(0.985 0.004 245); padding: 40px 32px;">
            <div style={"width: 32px; height: 3px; background: #{color}; margin-bottom: 20px;"}></div>
            <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 10px;"><%= role %></h3>
            <p style="font-size: 13px; color: oklch(0.48 0.02 255); line-height: 1.6; margin: 0 0 20px;"><%= tagline %></p>
            <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px;">
              <%= for item <- items do %>
                <li style="display: flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: oklch(0.44 0.02 255);">
                  <span style={"color: #{color};"}>&#x25B8;</span> <%= item %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ========== AI ARCHITECT SHOWCASE ========== -->
  <section style="padding: 96px 32px; background: oklch(0.22 0.025 255); overflow: hidden; position: relative;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(oklch(0.3 0.025 255 / 0.3) 1px, transparent 1px), linear-gradient(90deg, oklch(0.3 0.025 255 / 0.3) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none;"></div>

    <div style="max-width: 1280px; margin: 0 auto; position: relative; z-index: 1;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">

        <!-- Copy -->
        <div>
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: oklch(0.55 0.02 250); margin-bottom: 12px;">AI ARCHITECT</div>
          <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; color: oklch(0.96 0.008 245); margin: 0 0 20px; line-height: 1.2;">
            Turn your old prompts into<br/>
            <span style="color: oklch(0.65 0.13 255);">structured architecture.</span>
          </h2>
          <p style="font-size: 15px; line-height: 1.7; color: oklch(0.65 0.015 250); margin: 0 0 32px;">Paste any existing prompt. The AI Architect analyzes its structure, extracts variables, identifies reusable skills, and generates a proper graph — ready to edit, validate, and deploy.</p>

          <div style="display: flex; flex-direction: column; gap: 16px;">
            <%= for {cmd, result} <- [
              {"\"Add a rule requiring citations.\"", "Constraint node added → compiler updated"},
              {"\"Reduce prompt size by 20%.\"", "Skills merged → token count reduced"},
              {"\"Convert this into a reusable skill.\"", "Node promoted to Registry · v1.0"}
            ] do %>
              <div style="display: flex; gap: 16px; align-items: flex-start;">
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: oklch(0.65 0.13 255); padding: 10px 14px; background: oklch(0.28 0.025 255); border-left: 2px solid oklch(0.55 0.13 255); white-space: nowrap;"><%= cmd %></div>
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: oklch(0.55 0.12 155); padding: 10px 14px; background: oklch(0.25 0.02 255); border-left: 2px solid oklch(0.45 0.09 155);"><%= result %></div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Terminal mockup -->
        <div style="background: oklch(0.18 0.02 255); border: 1px solid oklch(0.32 0.025 255); font-family: 'IBM Plex Mono', monospace; font-size: 12px;">
          <div style="padding: 12px 16px; border-bottom: 1px solid oklch(0.32 0.025 255); display: flex; align-items: center; gap: 8px;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: oklch(0.55 0.14 28 / 0.6);"></div>
            <div style="width: 8px; height: 8px; border-radius: 50%; background: oklch(0.62 0.13 78 / 0.6);"></div>
            <div style="width: 8px; height: 8px; border-radius: 50%; background: oklch(0.55 0.12 155 / 0.6);"></div>
            <span style="color: oklch(0.45 0.02 250); margin-left: 8px; font-size: 11px;">nspark &mdash; AI Architect</span>
          </div>
          <div style="padding: 24px; line-height: 1.9; color: oklch(0.65 0.015 250);">
            <div style="color: oklch(0.5 0.02 250); margin-bottom: 8px;">&gt; Analyzing prompt...</div>
            <div style="color: oklch(0.55 0.12 155);">✓ Extracted 3 variables</div>
            <div style="color: oklch(0.55 0.12 155);">✓ Identified 2 reusable skills</div>
            <div style="color: oklch(0.55 0.12 155);">✓ Detected 1 constraint</div>
            <div style="color: oklch(0.5 0.02 250); margin-top: 8px; margin-bottom: 8px;">&gt; Generating graph...</div>
            <div style="color: oklch(0.65 0.013 255);">Created: Persona node</div>
            <div style="color: oklch(0.65 0.013 255);">Created: Constraint node (citation)</div>
            <div style="color: oklch(0.65 0.013 255);">Created: Context node (&#123;inventory&#125;)</div>
            <div style="color: oklch(0.65 0.013 255);">Linked: Planning skill &middot; v2</div>
            <div style="color: oklch(0.65 0.013 255);">Created: Output schema (JSON)</div>
            <div style="color: oklch(0.5 0.02 250); margin-top: 8px;">&gt; Running diagnostics...</div>
            <div style="color: oklch(0.55 0.12 155);">✓ <strong style="color: oklch(0.65 0.015 250);">Graph ready.</strong> 5 nodes · 4 edges</div>
            <div style="color: oklch(0.65 0.13 255); margin-top: 4px;">&#x25B8; 2,431 tokens &middot; 14% smaller than source</div>
            <div style="color: oklch(0.4 0.02 250); margin-top: 12px;">&gt; <span class="cursor-blink">_</span></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="hero-grid" style="padding: 112px 32px; text-align: center; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -40px; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(circle, oklch(0.55 0.13 255 / 0.08) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="max-width: 720px; margin: 0 auto; position: relative; z-index: 1;">
      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: oklch(0.55 0.02 250); margin-bottom: 16px;">GET STARTED</div>
